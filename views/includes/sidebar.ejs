<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Feedback System</title>

    <link rel="stylesheet" href="/css/sidebar.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body>
    <header class="navbar">
        <div class="logo">
            <i class="fa-regular fa-comment-dots"></i>
            <span>Smart Feedback Collection and Analysis System</span>
        </div>
        <div class="profile">
            <div class="profile-info">
                <span class="welcome">Welcome</span>
                <span class="username"><%= userName %></span>
            </div>
            <i class="fa-solid fa-circle-user profile-icon"></i>
        </div>
    </header>
    <aside class="sidebar">
        <ul>
            <li class="<%= activePage === "feedback" ? 'active' : '' %>">
                <a href="/feedback"><i class="fa-regular fa-pen-to-square"></i> Submit Feedback</a>
            </li>
            <li class="<%= activePage === "history" ? 'active' : '' %>">
                <a href="/history"><i class="fa-solid fa-clock-rotate-left"></i>My Feedback History</a>
            </li>
            <li>
                <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
            </li>
        </ul>
    </aside>
    </body>
</html>